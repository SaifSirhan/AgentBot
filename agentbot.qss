QWidget {
    background-color: #000000;
    color: #66ffcc;
    border: none;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
}

QFrame {
    border: none;
    margin: 0px;
    padding: 0px;
}

/* Right-panel cards: flat black terminal boxes, square mint outline. */
QFrame[panel="true"] {
    background-color: #000000;
    border: 1px solid #66ffcc;
    border-radius: 0px;
}

QPlainTextEdit, QLineEdit {
    background-color: #000000;
    border: none;
    margin: 0px;
    padding: 0px;
    selection-background-color: #66ffcc;
    selection-color: #000000;
}

QPushButton {
    background-color: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
    text-align: left;
}

QPushButton:hover, QPushButton:focus {
    background-color: transparent;
    color: #ffffff;
    text-decoration: underline;
}

QPushButton:pressed {
    background-color: transparent;
    color: #aaffdd;
}

QPushButton:disabled {
    color: #648276;
}
