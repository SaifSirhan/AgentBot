# ---- Local data / caches ----
rag_db/
AgentMemory/
*.log
research_*.md
# Timestamped backups written next to a file by document_tools before editing.
*.bak_*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Local mockup artifacts ----
_gui_mockup*.png

# ---- Local / non-source / sensitive artifacts (kept out of the repo) ----
# APIs.txt likely holds API keys; check-fk.php / sha512_sum are stray scratch
# files; the rest are binaries, OS metadata, or local backups.
APIs.txt
check-fk.php
sha512_sum
operadriver.exe
*.exe
desktop.ini
_backup_*/

# Browser recipes are local config: real URLs/selectors for the user's own
# sites, and a "type" step can carry credentials. Same rule as config.json.
recipes.json


# Telegram group export — a full private chat, kept outside the repo. Listed
# anyway so an accidental copy into the working tree can't be committed.
TelegramExport/
result.json
PrivateExport/
